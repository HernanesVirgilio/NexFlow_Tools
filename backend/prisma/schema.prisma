// NexFlow Tools — Phase 1 data model.
// Entities kept intentionally minimal: User, Profile, Workflow, WorkflowExecution.
// Migrations are the source of truth — never edit the DB by hand.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection — Supabase pooled connection (Transaction mode, port 6543).
  url       = env("DATABASE_URL")
  // Migrations / introspection — Supabase direct connection (port 5432).
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  // USER can only ever touch their own resources; ADMIN unlocks /api/admin/*
  // (see middleware/auth.ts requireRole). Never settable by the user themselves.
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile        Profile?
  workflows      Workflow[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  integrations   Integration[]

  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  avatarUrl String?
  language  String   @default("en") // "en" | "pt"
  theme     String   @default("system") // "light" | "dark" | "system"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Workflow {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isActive    Boolean  @default(false)
  // Reference to the workflow inside the automation engine (e.g. n8n workflow id).
  engine      String   @default("n8n")
  engineRef   String?
  // Visual builder graph: { version, nodes[], edges[] }. Null for legacy workflows.
  definition  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@index([userId])
  @@map("workflows")
}

enum IntegrationProvider {
  GOOGLE
}

// One real, user-owned OAuth connection. `encryptedRefreshToken` is reversible
// encryption (utils/crypto.ts) — not hashing — because the token must be used
// again later to call the provider; never store it in plaintext.
model Integration {
  id                    String              @id @default(cuid())
  userId                String
  provider              IntegrationProvider
  accountEmail          String?
  scope                 String
  encryptedRefreshToken String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("integrations")
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model WorkflowExecution {
  id           String          @id @default(cuid())
  workflowId   String
  userId       String // denormalised owner for fast isolation checks
  status       ExecutionStatus @default(PENDING)
  // Execution id returned by the automation engine, when available.
  engineRef    String?
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  errorMessage String?
  // Stable AppError code for a failed run (e.g. AUTOMATION_AUTH). Drives recovery UX.
  errorCode    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
  @@map("workflow_executions")
}
