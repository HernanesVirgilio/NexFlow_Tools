# ─────────────────────────────────────────────────────────────
# NexFlow Tools — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ---- Backend: server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# ---- Backend: database (Supabase-hosted PostgreSQL) ----
# From the Supabase dashboard: Project Settings -> Database -> Connection string.
# DATABASE_URL = pooled connection (Transaction mode, port 6543) used at runtime.
#   Append ?pgbouncer=true&connection_limit=1 as Supabase + Prisma recommend.
# DIRECT_URL   = direct connection (Session mode, port 5432) used by
#   `prisma migrate` / `prisma db push` / introspection.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Backend: auth (generate long random strings) ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Backend: n8n automation engine (server-side only) ----
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=change-me-n8n-api-key
N8N_TIMEOUT_MS=15000

# ---- Backend: NexFlow Intelligence — Gemini provider (server-side only) ----
# Leave blank in dev to get an honest "not configured" response instead of a
# fake AI answer. Never expose this key to the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=20000

# ---- Backend: outbound email (password recovery) ----
# Leave blank in dev to log reset links to the console instead of sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NexFlow Tools <no-reply@nexflow.tools>"
APP_WEB_URL=http://localhost:5173

# ---- Backend: demo seed guard ----
# The demo seed (npm run db:seed) refuses to run when NODE_ENV=production.
# Set this to "true" only to force it against a production database (not advised).
ALLOW_DEMO_SEED=

# ---- Frontend (Vite: only VITE_* vars are exposed to the browser) ----
VITE_API_BASE_URL=http://localhost:4000/api
# Show the "Demo environment" banner in the app. Dev/demo only — leave blank in prod.
VITE_DEMO_MODE=true
